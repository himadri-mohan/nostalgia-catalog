# Affiliate ids are optional. Leave them blank to publish plain official URLs.
# Set them in the host environment (for example Vercel project settings or .env.local).
# Never commit real ids. .env.local is gitignored; this example file is safe to commit.
#
# Preferred: server-only names. They are read when a show page renders and are not
# shipped as a separate client config. NEXT_PUBLIC_* is a fallback if the server-only
# name is unset. Values may contain letters, numbers, dots, underscores, tildes, and hyphens.

# Amazon Associates tracking id. Appended as the `tag` query param on amazon.com links.
AFFILIATE_AMAZON_TAG=
NEXT_PUBLIC_AFFILIATE_AMAZON_TAG=

# Apple Services affiliate token. Appended as the `at` query param on Apple TV links.
AFFILIATE_APPLE_AT=
NEXT_PUBLIC_AFFILIATE_APPLE_AT=

# Optional Disney+ campaign id. Appended as the `cid` query param on disneyplus.com links.
AFFILIATE_DISNEY_CID=
NEXT_PUBLIC_AFFILIATE_DISNEY_CID=
