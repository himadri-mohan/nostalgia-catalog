# Copy to .env.local for local runs. On Vercel, set the same names under
# Project → Settings → Environment Variables. Never commit real ids.
# .env.local is gitignored; this example file is safe to commit.
#
# See DEPLOY.md for the connect-and-deploy steps and the post-deploy smoke test.
#
# Preferred affiliate names are server-only. They are read when a show page renders
# and are not shipped as a separate client config. NEXT_PUBLIC_AFFILIATE_* is a
# fallback if the matching server-only name is unset. The server-only name wins
# when both are set. Values may contain letters, numbers, dots, underscores,
# tildes, and hyphens (up to 80 characters).

# Public origin for canonical URLs, Open Graph, sitemap.xml, and robots.txt.
# Example: https://your-domain.example
# No path and no trailing slash. Leave blank locally. If unset on Vercel, the
# app uses https://$VERCEL_URL, which Vercel sets for you.
NEXT_PUBLIC_SITE_URL=

# Amazon Associates tracking id. Appended as the `tag` query param on amazon.com links.
AFFILIATE_AMAZON_TAG=
NEXT_PUBLIC_AFFILIATE_AMAZON_TAG=

# Apple Services affiliate token. Appended as the `at` query param on Apple TV links.
AFFILIATE_APPLE_AT=
NEXT_PUBLIC_AFFILIATE_APPLE_AT=

# Optional Disney+ campaign id. Appended as the `cid` query param on disneyplus.com links.
AFFILIATE_DISNEY_CID=
NEXT_PUBLIC_AFFILIATE_DISNEY_CID=

# Do not add analytics variables. This app does not use Vercel Analytics or any paid analytics package.
